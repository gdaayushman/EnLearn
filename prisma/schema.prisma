// Prisma schema mirroring the master-prompt DB spec.
// Datasource is Postgres; swap provider = "mysql" if you prefer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  admin
  sub_admin
}

enum BatchType {
  recorded
  live
  hybrid
}

enum ContentType {
  video
  pdf
  dpp
  test
  link
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum TestType {
  mock
  topic
  pyq
  live
}

enum PostType {
  doubt
  discussion
  announcement
}

enum RequestStatus {
  pending
  approved
  rejected
}

model Category {
  id            BigInt        @id @default(autoincrement())
  name          String
  slug          String        @unique
  description   String?
  icon          String?
  displayOrder  Int           @default(0)  @map("display_order")
  isActive      Boolean       @default(true) @map("is_active")
  isPaid        Boolean       @default(false) @map("is_paid")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id           BigInt   @id @default(autoincrement())
  categoryId   BigInt   @map("category_id")
  name         String
  slug         String   @unique
  description  String?
  icon         String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  tags         Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  batches  Batch[]

  @@map("sub_categories")
}

model Batch {
  id               BigInt      @id @default(autoincrement())
  subCategoryId    BigInt      @map("sub_category_id")
  name             String
  slug             String      @unique
  batchCode        String      @unique @map("batch_code")
  description      String?
  batchType        BatchType   @default(recorded) @map("batch_type")
  price            Decimal     @default(0) @db.Decimal(10, 2)
  discountedPrice  Decimal?    @map("discounted_price") @db.Decimal(10, 2)
  validityMonths   Int         @default(12) @map("validity_months")
  language         String      @default("Hinglish")
  thumbnailUrl     String?     @map("thumbnail_url")
  isFree           Boolean     @default(false) @map("is_free")
  isActive         Boolean     @default(true) @map("is_active")
  startsFrom       DateTime?   @map("starts_from") @db.Date
  enrollmentCount  Int         @default(0) @map("enrollment_count")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  subCategory        SubCategory         @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  contents           BatchContent[]
  enrollments        Enrollment[]
  orders             Order[]
  tests              Test[]
  posts              CommunityPost[]
  enrollmentRequests EnrollmentRequest[]
  curriculum         BatchCurriculum?
  dailyDpps          DailyDPP[]

  @@map("batches")
}

model Subject {
  id           BigInt    @id @default(autoincrement())
  name         String
  slug         String    @unique
  icon         String?
  displayOrder Int       @default(0) @map("display_order")
  chapters     Chapter[]

  @@map("subjects")
}

model Chapter {
  id           BigInt         @id @default(autoincrement())
  subjectId    BigInt         @map("subject_id")
  name         String
  slug         String
  displayOrder Int            @default(0) @map("display_order")
  isActive     Boolean        @default(true) @map("is_active")

  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  contents BatchContent[]

  @@unique([subjectId, slug])
  @@map("chapters")
}

model BatchContent {
  id              BigInt      @id @default(autoincrement())
  batchId         BigInt      @map("batch_id")
  chapterId       BigInt?     @map("chapter_id")
  contentType     ContentType @map("content_type")
  title           String
  description     String?
  fileUrl         String?     @map("file_url")
  videoUrl        String?     @map("video_url")
  embedUrl        String?     @map("embed_url")
  durationMinutes Int?        @map("duration_minutes")
  displayOrder    Int         @default(0) @map("display_order")
  isPreview       Boolean     @default(false) @map("is_preview")
  isCompleted     Boolean     @default(false) @map("is_completed")
  // For generated DPPs: stores question JSON so we can regenerate the PDF on demand.
  generatedData   Json?       @map("generated_data")
  createdAt       DateTime    @default(now()) @map("created_at")

  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id])

  @@map("batch_content")
}

model User {
  id         BigInt   @id @default(autoincrement())
  publicId   String   @unique @default(cuid()) @map("public_id") // shareable "unique id" you use to identify DMs
  name       String
  email      String   @unique
  phone      String?  @unique
  password   String
  role       Role     @default(student)
  avatarUrl  String?  @map("avatar_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  enrollments        Enrollment[]
  orders             Order[]
  attempts           TestAttempt[]
  posts              CommunityPost[]
  replies            CommunityReply[]
  enrollmentRequests EnrollmentRequest[]

  @@map("users")
}

model EnrollmentRequest {
  id          BigInt        @id @default(autoincrement())
  userId      BigInt        @map("user_id")
  batchId     BigInt        @map("batch_id")
  status      RequestStatus @default(pending)
  note        String?       // student's note (optional)
  adminNote   String?       @map("admin_note") // admin's internal note when approving/rejecting
  createdAt   DateTime      @default(now()) @map("created_at")
  reviewedAt  DateTime?     @map("reviewed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("enrollment_requests")
}

model Enrollment {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  batchId    BigInt   @map("batch_id")
  orderId    BigInt?  @map("order_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean  @default(true) @map("is_active")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([userId, batchId])
  @@map("enrollments")
}

model Order {
  id             BigInt        @id @default(autoincrement())
  userId         BigInt        @map("user_id")
  batchId        BigInt        @map("batch_id")
  amount         Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal       @map("final_amount") @db.Decimal(10, 2)
  paymentMethod  String?       @map("payment_method")
  paymentStatus  PaymentStatus @default(pending) @map("payment_status")
  transactionId  String?       @map("transaction_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id])
  batch       Batch        @relation(fields: [batchId], references: [id])
  enrollments Enrollment[]

  @@map("orders")
}

model Test {
  id             BigInt   @id @default(autoincrement())
  batchId        BigInt   @map("batch_id")
  title          String
  description    String?
  testType       TestType @default(mock) @map("test_type")
  totalMarks     Int      @default(0) @map("total_marks")
  totalQuestions Int      @default(0) @map("total_questions")
  durationMinutes Int     @default(60) @map("duration_minutes")
  isActive       Boolean  @default(true) @map("is_active")

  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attempts  TestAttempt[]
  questions TestQuestion[]

  @@map("tests")
}

model TestQuestion {
  id            BigInt   @id @default(autoincrement())
  testId        BigInt   @map("test_id")
  questionText  String   @map("question_text")
  marks         Int      @default(1)
  negativeMarks Int      @default(0) @map("negative_marks")
  displayOrder  Int      @default(0) @map("display_order")
  explanation   String?

  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  options TestOption[]

  @@map("test_questions")
}

model TestOption {
  id           BigInt  @id @default(autoincrement())
  questionId   BigInt  @map("question_id")
  optionText   String  @map("option_text")
  isCorrect    Boolean @default(false) @map("is_correct")
  displayOrder Int     @default(0) @map("display_order")

  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("test_options")
}

model TestAttempt {
  id               BigInt        @id @default(autoincrement())
  userId           BigInt        @map("user_id")
  testId           BigInt        @map("test_id")
  score            Int           @default(0)
  totalMarks       Int           @default(0) @map("total_marks")
  rank             Int?
  timeTakenMinutes Int?          @map("time_taken_minutes")
  answers          Json?         // { [questionId]: optionId }
  status           AttemptStatus @default(in_progress)
  startedAt        DateTime      @default(now()) @map("started_at")
  submittedAt      DateTime?     @map("submitted_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  test Test @relation(fields: [testId], references: [id])

  @@map("test_attempts")
}

enum AttemptStatus {
  in_progress
  submitted
}

model CommunityPost {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  batchId    BigInt?  @map("batch_id")
  content    String
  postType   PostType @default(doubt) @map("post_type")
  upvotes    Int      @default(0)
  isAnswered Boolean  @default(false) @map("is_answered")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id])
  batch   Batch?           @relation(fields: [batchId], references: [id])
  replies CommunityReply[]

  @@map("community_posts")
}

model CommunityReply {
  id         BigInt   @id @default(autoincrement())
  postId     BigInt   @map("post_id")
  userId     BigInt   @map("user_id")
  content    String
  isAccepted Boolean  @default(false) @map("is_accepted")
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@map("community_replies")
}

/// A per-batch, ordered curriculum: subjects → chapters → topics.
/// Generated by AI once per batch, editable by admin, drives daily DPP progression.
model BatchCurriculum {
  id           BigInt   @id @default(autoincrement())
  batchId      BigInt   @unique @map("batch_id")
  data         Json     // { subjects: [{ name, chapters: [{ name, topics: [string] }] }] }
  generatedAt  DateTime @default(now()) @map("generated_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("batch_curriculums")
}

/// Cached daily DPP: a specific day's 20 questions for a batch. Once generated,
/// every student in that batch on that day gets the same paper.
model DailyDPP {
  id            BigInt   @id @default(autoincrement())
  batchId       BigInt   @map("batch_id")
  dayNumber     Int      @map("day_number")           // Day 1, Day 2, ...
  subject       String
  chapter       String
  topic         String
  questions     Json     // DPPQuestion[]
  createdAt     DateTime @default(now()) @map("created_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, dayNumber])
  @@index([batchId])
  @@map("daily_dpps")
}

model Coupon {
  id           BigInt   @id @default(autoincrement())
  code         String   @unique
  discountPct  Int?     @map("discount_pct")
  discountAmt  Decimal? @map("discount_amt") @db.Decimal(10, 2)
  validFrom    DateTime @map("valid_from")
  validTo      DateTime @map("valid_to")
  usageLimit   Int      @default(0) @map("usage_limit")
  timesUsed    Int      @default(0) @map("times_used")
  isActive     Boolean  @default(true) @map("is_active")

  @@map("coupons")
}
